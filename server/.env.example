# Copiar este archivo a server/.env y ajustar valores. Nunca versionar .env.

# development | production | test
NODE_ENV=development

# Railway inyecta PORT automáticamente en producción.
PORT=3000

# SQLite. Ruta relativa a server/prisma/schema.prisma.
# En Railway usar un volumen montado en /data:  DATABASE_URL=file:/data/app.db
DATABASE_URL=file:./dev.db

# URL pública de la aplicación (enlaces de recuperación de contraseña).
APP_URL=http://localhost:5173

# Orígenes adicionales permitidos por CORS, separados por coma. Vacío = solo mismo origen.
CORS_ORIGINS=http://localhost:5173

# Número de proxies de confianza delante del servidor (Railway: 1). Necesario para la IP real.
TRUST_PROXY=0

# Duración de la sesión en horas.
SESSION_TTL_HOURS=12

# Expiración del token de recuperación (30 a 60 minutos).
RESET_TOKEN_TTL_MINUTES=45

# Rate limiting global de la API y específico de autenticación.
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=30

# Carpeta donde se guardan los correos en desarrollo (no se usa en producción).
MAIL_OUTBOX_DIR=.mail-outbox

# Seed manual (npm run db:seed). Contraseña de los usuarios de prueba (mínimo 12 caracteres).
SEED_TEST_PASSWORD=Prueba123*Spa
