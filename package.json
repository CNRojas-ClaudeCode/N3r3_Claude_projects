{
  "name": "spa-nereyda",
  "version": "0.1.0",
  "private": true,
  "description": "SPA Nereyda - gestión de miscelánea (usuarios, clientes, productos, facturación, cartera y capacitación)",
  "workspaces": [
    "server",
    "client"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "build": "npm run build -w server && npm run build -w client",
    "start": "npm run start -w server",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w client",
    "test": "npm run test -w server",
    "audit:security": "node scripts/audit-security.js",
    "roles:generate": "node scripts/generate-roles.mjs",
    "icons:generate": "node scripts/generate-icons.mjs",
    "db:migrate": "npm run db:migrate -w server",
    "db:deploy": "npm run db:deploy -w server",
    "db:seed": "npm run db:seed -w server",
    "db:seed:demo": "npm run db:seed:demo -w server"
  },
  "devDependencies": {
    "rollup": "npm:@rollup/wasm-node@^4.64.12"
  },
  "overrides": {
    "rollup": "$rollup"
  }
}
